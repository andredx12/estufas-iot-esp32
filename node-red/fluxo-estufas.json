    {
        "id": "52d54a9c8f5ea62f",
        "type": "function",
        "z": "58bba0827de9fc02",
        "name": "Dados da estufa de repolho",
        "func": "// Separar a telemetria do ESP32 para cada item do painel\nconst d = msg.payload;\nif (typeof d !== 'object' || d === null) {\n    return null;\n}\n\nconst hora = new Date().toLocaleTimeString('pt-BR', { timeZone: 'America/Sao_Paulo' });\n\n// Estado de cada equipamento em texto\nfunction estado(ligado, modo) {\n    const texto = ligado ? 'LIGADA' : 'DESLIGADA';\n    return texto + (modo === 'auto' ? ' (automático)' : ' (manual)');\n}\n\n// Modo atual do ESP32 no formato dos botões\nconst botao = { auto: 'AUTO', ligado: 'LIGAR', desligado: 'DESLIGAR' };\n\nreturn [\n    { payload: hora },\n    { payload: d.limite_temp + ' °C' },\n    { payload: d.limite_solo + ' %' },\n    { payload: d.temperatura },\n    { payload: d.umidade_ar },\n    { payload: d.umidade_solo },\n    { payload: Math.round(d.luminosidade / 100) / 10 },\n    [\n        { topic: 'Temperatura (°C)', payload: d.temperatura },\n        { topic: 'Umidade do solo (%)', payload: d.umidade_solo }\n    ],\n    { payload: estado(d.irrigacao, d.modo_irrigacao) },\n    { payload: botao[d.modo_irrigacao] },\n    { payload: estado(d.ventilacao, d.modo_ventilacao) },\n    { payload: botao[d.modo_ventilacao] },\n    { payload: estado(d.iluminacao, d.modo_iluminacao) },\n    { payload: botao[d.modo_iluminacao] },\n    { payload: d.alerta ? 'CONDIÇÃO CRÍTICA (buzzer ligado)' : 'nenhum' }\n];\n",
        "outputs": 15,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 470,
        "y": 1040,
        "wires": [
